+import {test,expect,type Page,type Locator} from '@playwright/test';
+import {readFileSync,writeFileSync,realpathSync} from 'node:fs';
+import {join,resolve,dirname} from 'node:path';
+import {createRequire} from 'node:module';
+import {pathToFileURL} from 'node:url';
+import {createHash} from 'node:crypto';
+import {newsletterFixture} from './helpers/newsletter-fixture';
+import {createCmsSources} from './helpers/cms-source-ownership';
+import {assertContactSettingsMutation,coerceContactSettingsVariables} from './helpers/contact-social-native-admission';
+import {expectedNativeDocument,type Schema,type Mutation} from './helpers/native-document';
+test.skip(!process.env.NEWSLETTER_DIRECTORY,'Owned newsletter acceptance only');
+const hash=(value:string|Buffer)=>createHash('sha256').update(value).digest('hex');
+test('native newsletter WYSIWYG saves and dormant module roundtrip',async({browser})=>{
+ test.setTimeout(600000);const f=await newsletterFixture('native');let prior=JSON.parse(readFileSync(f.sourcePath,'utf8'));const sources=createCmsSources([f.sourcePath],join(f.directory,'source'));let schema:Schema,sdl:string,pending:any,baselineNative:any;const saves:any[]=[];const require=createRequire(import.meta.url);const serializerPath=realpathSync(resolve(dirname(require.resolve('@tinacms/cli')),'../../graphql/dist/index.js'));const serializer=await import(pathToFileURL(serializerPath).href);
+ const context=await browser.newContext();const page=await context.newPage();page.setDefaultTimeout(20000);
+ async function loadSchema(){const raw:Schema=JSON.parse(readFileSync(join(f.root,'tina/__generated__/_schema.json'),'utf8'));schema={...raw,collections:raw.collections.map(c=>({...c,path:resolve(f.root,c.path)}))};sdl=readFileSync(join(f.root,'tina/__generated__/schema.gql'),'utf8');const indexed=await(await fetch('http://localhost:4010/graphql',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({query:'query { settings(relativePath: "site.json") { _values } }'})})).json() as any;expect(indexed.errors||[]).toEqual([]);baselineNative=indexed.data.settings._values;writeFileSync(join(f.directory,'schema-'+saves.length+'.json'),JSON.stringify({raw,sdl,serializer:{path:serializerPath,sha256:hash(readFileSync(serializerPath))}},null,2));}
