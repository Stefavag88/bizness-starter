---
import Layout from '../../layouts/Layout.astro';
import Page from '../../templates/Page.astro';
import EditorialDetail from '../../templates/EditorialDetail.astro';
import {domainRenderer,assertDomainRendererCoverage} from '../../templates/domains';
import {getDomainRouteRecord} from '../../../../../packages/content/domain-publication.mjs';
import {contents,routes,description,project} from '../../lib/content';
export function getStaticPaths(){assertDomainRendererCoverage(project);return routes.map(route=>({params:{locale:route.locale,path:route.path.split('/').slice(2).join('/')||undefined},props:{route}}));}
const {route}=Astro.props;const content=contents.find(c=>c.locale===route.locale)!;
const page=route.kind==='page'?content.pages.find(r=>r.contentId===route.contentId):undefined;
const editorial=(route.kind==='offering'?content.offerings:route.kind==='person'?content.people:content.articles).find(r=>r.contentId===route.contentId);
const record=page??(route.kind==='domain'?getDomainRouteRecord(content,route.domain,route.contentId):editorial)!;
const Renderer=route.kind==='domain'?domainRenderer(route.domain):undefined;
const title='meta' in record?record.meta.title:record.title;
---
<Layout content={content} title={title} description={description('meta' in record?{...record,seoDescription:record.meta.seoDescription}:record)} path={route.path} alternates={route.alternates}>
{page?<Page page={page} content={content}/>:Renderer?<Renderer record={record} content={content}/>:editorial&&<EditorialDetail record={editorial} content={content}/>}
</Layout>
