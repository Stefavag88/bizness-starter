---
import '../styles/foundations.css';
import '../styles/themes.generated.css';
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/newsletter.css';
import NewsletterFooter from '../components/newsletter/NewsletterFooter.astro';
import VisitorDialogs from '../components/newsletter/VisitorDialogs.astro';
import {resolveNewsletterExperience} from '../../../../packages/content/newsletter.mjs';
import {newsletterMessages} from '../scripts/newsletter-messages';
import '@fontsource/noto-sans/400.css';
import '@fontsource/noto-sans/600.css';
import ContactDetails from '../components/ui/ContactDetails.astro';
import SocialLinks from '../components/ui/SocialLinks.astro';
import {contactChannels} from '../../../../packages/content/contact.mjs';
import RichText from '../components/ui/RichText.astro';
import {renderContext as defaultContext} from '../lib/content';
import type {RenderContext} from '../lib/render-context';
import type {LocalizedContent,Alternate} from '../../../../packages/content/types';
interface Props {context?:RenderContext;content:LocalizedContent;title:string;description:string;path:string;alternates:Alternate[];noindex?:boolean}
const {content,title,description,path,alternates,noindex=false,context=defaultContext}=Astro.props;const project=context.project;const preview=Boolean(context.previewBase);const {settings,locale}=content;const href=(value:string|undefined)=>value?context.link(value,locale):undefined;const el=locale==='el';const channels=contactChannels(settings,locale);if(preview){channels.social=[];channels.direct=channels.direct.map(item=>({...item,href:'#'}));}
const currentPage=content.pages.find(page=>page.path===path);
const experience=preview?null:resolveNewsletterExperience(settings,project,{locale,privacyHref:content.pages.find(page=>page.contentId==='privacy')?.path??null,pageKind:noindex?'system':currentPage?.contentId==='privacy'?'privacy':currentPage?._template??'editorial',localProtectionAvailable:project.environment==='local'});
const contactHref=content.pages.find(page=>page._template==='contact')?.path??`/${locale}/contact`;const visitorMessages=newsletterMessages(locale);
---
<!doctype html><html data-motion={project.design.motion.enabled?'on':'off'} lang={locale} data-theme={project.design.theme} data-density={project.design.density}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | {settings.brand.name}</title><meta name="description" content={description}/>{!preview&&<link rel="canonical" href={new URL(path,project.siteUrl).href}/>}{(noindex||preview)&&<meta name="robots" content="noindex"/>}{!preview&&alternates.map(a=><link rel="alternate" hreflang={a.locale} href={project.siteUrl+a.path}/>)}{!preview&&content.feedPath&&<link rel="alternate" type="application/rss+xml" title={settings.brand.name} href={content.feedPath}/>}</head><body>{preview&&<aside class="template-preview-notice"><a href="/templates">{el?'Πίσω στα πρότυπα':'Back to templates'}</a><span>{el?'Προεπισκόπηση — οι φόρμες είναι ανενεργές':'Template preview — forms are disabled'}</span></aside>}
<a class="skip" href="#main">{el?'Μετάβαση στο περιεχόμενο':'Skip to content'}</a>
<header class="wrap"><a class="brand" href={href(content.pages.find(p=>p._template==='home')?.path)}>{settings.brand.name}</a><nav aria-label={el?'Κύρια πλοήγηση':'Main navigation'}>{settings.navigation.map(n=><a href={href(content.pages.find(p=>p.contentId===n.pageId)!.path)} aria-current={content.pages.find(p=>p.contentId===n.pageId)?.path===path?'page':undefined}>{n.label}</a>)}</nav><nav aria-label={el?'Γλώσσα':'Language'}>{alternates.map(a=><a href={context.link(a.path,a.locale)} lang={a.locale} hreflang={a.locale} aria-current={a.locale===locale?'true':undefined}>{project.languages.find(l=>l.code===a.locale)?.label}</a>)}</nav>{settings.social.showInHeader&&<SocialLinks links={channels.social} locale={locale} variant="icons" placement="header"/>}</header>
<main id="main"><slot/></main><footer class="wrap"><div class="footer-groups"><div class="footer-identity"><p>{settings.brand.tagline}</p><p>{settings.legal.businessName}</p><RichText context={context} body={settings.legal.notice} locale={locale}/><a href={href(content.pages.find(p=>p.contentId==='privacy')?.path)}>{el?'Απόρρητο':'Privacy'}</a></div><ContactDetails channels={channels} locale={locale}/><SocialLinks links={channels.social} locale={locale} variant="labeled" placement="footer"/></div>{experience&&<div data-visitor-experience={experience.canSubmit?true:undefined} data-project={project.name} data-interest={experience.interest} data-delay-seconds={experience.delaySeconds} data-dismiss-days={experience.dismissDays} data-accepted-days={experience.acceptedDays} data-auto-eligible={String(experience.autoEligible)}><NewsletterFooter model={experience} locale={locale} contactHref={contactHref}/>{experience.canSubmit&&experience.preferences&&<button type="button" class="visitor-preferences-button" data-preferences-open data-preferences-open-footer hidden>{visitorMessages.preferences}</button>}<VisitorDialogs model={experience} locale={locale}/></div>}</footer>
<script src="../scripts/site-entry.ts"></script></body></html>
