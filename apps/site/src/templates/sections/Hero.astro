---
import type {RenderContext} from '../../lib/render-context';
import {renderContext as defaultContext} from '../../lib/content';
import Description from '../../components/ui/Description.astro';
import Button from '../../components/ui/Button.astro';
import type {LocalizedSection} from '../../../../../packages/content/types';
interface Props {context?:RenderContext;section:Extract<LocalizedSection,{_template:'hero'}>;locale:string;primary?:boolean}
const {section,locale,primary=false,context=defaultContext}=Astro.props;const {copy}=section;const Heading=primary?'h1':'h2';
---
<section class="hero" data-surface={section.appearance.surface} aria-labelledby={section.id}><div class="wrap" data-motion-reveal={!primary || undefined}><Heading id={section.id}>{copy.title}</Heading><Description context={context} text={copy.description} locale={locale}/>{copy.link&&<Button context={context} {...copy.link} locale={locale}/>}</div></section>
