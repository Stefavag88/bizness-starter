---
import Description from '../../components/ui/Description.astro';
import Button from '../../components/ui/Button.astro';
import type {LocalizedSection} from '../../../../../packages/content/types';
interface Props {section:Extract<LocalizedSection,{_template:'cta'}>;locale:string}
const {section,locale}=Astro.props;
---
<section data-surface={section.appearance.surface} aria-labelledby={section.id}><div class="wrap" data-motion-reveal><h2 id={section.id}>{section.copy.title}</h2><Description text={section.copy.description} locale={locale}/><Button {...section.copy.link} locale={locale}/></div></section>
