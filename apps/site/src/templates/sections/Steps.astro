---
import type {RenderContext} from '../../lib/render-context';
import {renderContext as defaultContext} from '../../lib/content';
import RichText from '../../components/ui/RichText.astro';
import type {LocalizedSection} from '../../../../../packages/content/types';
interface Props {context?:RenderContext;section:Extract<LocalizedSection,{_template:'steps'}>;locale:string}
const {section,locale,context=defaultContext}=Astro.props;
---
<section data-surface={section.appearance.surface} aria-labelledby={section.id}><div class="wrap"><div data-motion-reveal><h2 id={section.id}>{section.copy.title}</h2><div class="description" set:html={context.rich(section.copy.description,locale,true)}/></div><ol data-motion-group class:list={['steps',{'steps-cards':section.variant==='cards'}]}>{section.copy.items.map(item=><li data-motion-reveal><h3>{item.title}</h3><RichText context={context} body={item.body} locale={locale}/></li>)}</ol></div></section>
