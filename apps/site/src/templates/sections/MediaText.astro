---
import RichText from '../../components/ui/RichText.astro';
import Button from '../../components/ui/Button.astro';
import SectionImage from '../../components/ui/SectionImage.astro';
import {resolveSectionMedia} from '../../lib/section-media';
import type {LocalizedSection} from '../../../../../packages/content/types';
interface Props {section:Extract<LocalizedSection,{_template:'media-text'}>;locale:string;pageId?:string}
const {section,locale,pageId='unknown'}=Astro.props;
const media=section.enabled===false?undefined:await resolveSectionMedia(section.media,{pageId,sectionId:section.id});
---
<section data-surface={section.appearance.surface} aria-labelledby={section.id}><div class:list={['wrap','media-text',{'media-text-reversed':section.variant==='reversed','media-text-with-image':!!media}]}>{media&&section.copy.image&&<SectionImage layout="media-text" media={media} {...section.copy.image} crop={section.media!.crop} ratio="landscape" locale={locale}/>}<div class="media-text-copy"><h2 id={section.id}>{section.copy.title}</h2><RichText body={section.copy.body} locale={locale}/>{section.copy.link&&<Button {...section.copy.link} locale={locale}/>}</div></div></section>
