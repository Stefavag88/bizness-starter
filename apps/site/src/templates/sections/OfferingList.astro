---
import Description from '../../components/ui/Description.astro';
import Card from '../../components/ui/Card.astro';
import type {LocalizedSection,LocalizedContent} from '../../../../../packages/content/types';
interface Props {section:Extract<LocalizedSection,{_template:'offering-list'}>;content:LocalizedContent;locale:string}
const {section,content,locale}=Astro.props;
---
<section data-surface={section.appearance.surface} aria-labelledby={section.id}><div class="wrap"><div data-motion-reveal><h2 id={section.id}>{section.copy.title}</h2><Description text={section.copy.description} locale={locale}/></div><div class="cards" data-motion-group>{content.offerings.map(record=><Card record={record} locale={locale}/>)}</div></div></section>
