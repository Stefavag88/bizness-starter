---
import RichText from '../../components/ui/RichText.astro';
import {rich} from '../../lib/content';
import type {LocalizedSection} from '../../../../../packages/content/types';
interface Props {section:Extract<LocalizedSection,{_template:'faq'}>;locale:string}
const {section,locale}=Astro.props;
---
<section data-surface={section.appearance.surface} aria-labelledby={section.id}><div class="wrap"><h2 id={section.id}>{section.copy.title}</h2><div class="description" set:html={rich(section.copy.description,locale,true)}/><div class="faq-items">{section.copy.items.map(item=>section.variant==='expanded'?<div class="faq-item"><h3>{item.question}</h3><RichText body={item.answer} locale={locale}/></div>:<details class="faq-item"><summary>{item.question}</summary><RichText body={item.answer} locale={locale}/></details>)}</div></div></section>
