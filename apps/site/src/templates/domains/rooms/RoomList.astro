---
import type {RenderContext} from '../../../lib/render-context';
import {renderContext as defaultContext} from '../../../lib/content';
import Description from '../../../components/ui/Description.astro';
import SectionImage from '../../../components/ui/SectionImage.astro';
import {resolveSectionMedia} from '../../../lib/section-media';
import {getDomainRecords} from '../../../../../../packages/content/domain-publication.mjs';
import type {LocalizedSection,LocalizedContent} from '../../../../../../packages/content/types';
interface Props {context?:RenderContext;section:Extract<LocalizedSection,{_template:'room-list'}>;content:LocalizedContent;locale:string}
const {section,content,locale,context=defaultContext}=Astro.props;
const rooms=await Promise.all(getDomainRecords(content,'rooms').map(async record=>({record,image:record.images[0],media:await resolveSectionMedia(record.images[0]?.media,{pageId:record.contentId,sectionId:section.id,itemId:record.images[0]?.id})})));
---
<section data-surface={section.appearance.surface} aria-labelledby={section.id}><div class="wrap"><div data-motion-reveal><h2 id={section.id}>{section.copy.title}</h2><Description context={context} text={section.copy.description} locale={locale}/></div>{rooms.length?<div class="cards" data-motion-group>{rooms.map(({record,image,media})=><article class="card">{media&&<SectionImage context={context} layout="room-card" itemCount={rooms.length} media={media} alt={image.alt} crop={image.media.crop} ratio="landscape" locale={locale}/>}<div data-motion-reveal><h3><a href={context.link(record.path,locale)}>{record.title}</a></h3><Description context={context} text={record.description} locale={locale}/><p>{locale==='el'?'Έως':'Up to'} {record.maxGuests} {locale==='el'?'επισκέπτες':'guests'}</p></div></article>)}</div>:<p>{section.copy.emptyMessage}</p>}</div></section>
