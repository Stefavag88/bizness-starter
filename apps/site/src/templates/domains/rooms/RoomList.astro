---
import Description from '../../../components/ui/Description.astro';
import SectionImage from '../../../components/ui/SectionImage.astro';
import {resolveSectionMedia} from '../../../lib/section-media';
import {getDomainRecords} from '../../../../../../packages/content/domain-publication.mjs';
import type {LocalizedSection,LocalizedContent} from '../../../../../../packages/content/types';
interface Props {section:Extract<LocalizedSection,{_template:'room-list'}>;content:LocalizedContent;locale:string}
const {section,content,locale}=Astro.props;
const rooms=await Promise.all(getDomainRecords(content,'rooms').map(async record=>({record,image:record.images[0],media:await resolveSectionMedia(record.images[0]?.media,{pageId:record.contentId,sectionId:section.id,itemId:record.images[0]?.id})})));
---
<section data-surface={section.appearance.surface} aria-labelledby={section.id}><div class="wrap"><h2 id={section.id}>{section.copy.title}</h2><Description text={section.copy.description} locale={locale}/>{rooms.length?<div class="cards">{rooms.map(({record,image,media})=><article class="card">{media&&<SectionImage media={media} alt={image.alt} crop={image.media.crop} ratio="landscape" locale={locale}/>}<h3><a href={record.path}>{record.title}</a></h3><Description text={record.description} locale={locale}/><p>{locale==='el'?'Έως':'Up to'} {record.maxGuests} {locale==='el'?'επισκέπτες':'guests'}</p></article>)}</div>:<p>{section.copy.emptyMessage}</p>}</div></section>
