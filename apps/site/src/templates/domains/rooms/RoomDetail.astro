---
import type {RenderContext} from '../../../lib/render-context';
import {renderContext as defaultContext} from '../../../lib/content';
import Description from '../../../components/ui/Description.astro';
import RichText from '../../../components/ui/RichText.astro';
import SectionImage from '../../../components/ui/SectionImage.astro';
import {resolveSectionMedia} from '../../../lib/section-media';
import type {LocalizedRoom} from '../../../../../../packages/domains/rooms/types';
import type {LocalizedContent} from '../../../../../../packages/content/types';
interface Props {context?:RenderContext;record:LocalizedRoom;content:LocalizedContent}
const {record,content,context=defaultContext}=Astro.props;
const contact=content.pages.find(p=>p._template==='contact');
const images=await Promise.all(record.images.map(async image=>({...image,resolved:await resolveSectionMedia(image.media,{pageId:record.contentId,sectionId:'room_images',itemId:image.id})})));
const el=content.locale==='el';
---
<article class="wrap editorial"><h1>{record.title}</h1><Description context={context} text={record.description} locale={content.locale}/><p>{el?'Έως':'Up to'} {record.maxGuests} {el?'επισκέπτες':'guests'}</p><p>{record.bedDescription}</p>{record.amenities.length>0&&<ul>{record.amenities.map(item=><li>{item.label}</li>)}</ul>}<RichText context={context} body={record.body} locale={content.locale}/>{images.map(image=><SectionImage context={context} layout="room-detail" media={image.resolved!} alt={image.alt} caption={image.caption} crop={image.media.crop} ratio="gallery" locale={content.locale}/>)}{contact&&<p><a class="button" href={context.link(contact.path+'?contextId='+encodeURIComponent(record.contentId),content.locale)}>{el?'Ρωτήστε για αυτό το δωμάτιο':'Enquire about this room'}</a></p>}</article>
