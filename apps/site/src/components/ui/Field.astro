---
interface Props {name:string;label:string;type?:'text'|'email'|'tel';required?:boolean;minlength?:number;maxlength?:number;autocomplete?:string;multiline?:boolean}
const {name,label,type='text',required=false,minlength,maxlength,autocomplete,multiline=false}=Astro.props;
---
<div class="field"><label for={name}>{label}{required?' *':''}</label>{multiline?<textarea id={name} name={name} required={required} minlength={minlength} maxlength={maxlength} rows="6" aria-describedby={name+'-error'} />:<input id={name} name={name} type={type} required={required} minlength={minlength} maxlength={maxlength} autocomplete={autocomplete} aria-describedby={name+'-error'}/>}<span id={name+'-error'} class="field-error"></span></div>
